BOT_TOKEN=123456:REPLACE_ME
ADMIN_IDS=123456789
# PostgreSQL: сигналы и тики OI-бота
DATABASE_URL=postgresql+asyncpg://oi_bot:oi_bot@127.0.0.1:5432/oi_bot
# PostgreSQL: кумулятивная дельта по токенам из вотчлиста (отдельная база)
DELTA_DATABASE_URL=postgresql+asyncpg://oi_bot:oi_bot@127.0.0.1:5432/oi_delta
# Локальные тесты / запасной вариант:
# DATABASE_URL=sqlite+aiosqlite:///./data/oi_bot.db
CONFIG_PATH=./config.yaml
LOG_LEVEL=INFO
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Второй бот: только сигналы со статусом confirmed
CONFIRMED_BOT_TOKEN=
CONFIRMED_CHAT_IDS=
# Страница графика. Пустой CHART_TOKEN — без пароля, слушайте только localhost.
CHART_HOST=127.0.0.1
CHART_PORT=8000
CHART_TOKEN=
